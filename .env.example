# ############################################################
# BU DOSYA ŞABLONDUR VE GITHUB'A GİDER.
# Buraya gerçek anahtar YAZMA. Gerçek değerler .env.local'a yazılır.
# ############################################################

# --- Supabase (Faz 1-2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucu tarafı. NEXT_PUBLIC_ ile BAŞLAMAZ, istemciye gitmez.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (Faz 6-7) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3007

# --- Rezervasyon talebi bildirimleri (Faz 4) ---
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Spam koruması (Faz 4) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- İzleme (Faz 7) ---
NEXT_PUBLIC_GA_ID=
SENTRY_DSN=
